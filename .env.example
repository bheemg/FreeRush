# ---------------------------------------------------------------------------
# FreeRush environment. Copy to `.env` and fill in. Everything here targets a
# $0 / free-tier setup; paid provider keys are optional and only swap in later.
# ---------------------------------------------------------------------------

# Postgres (the docker-compose service name is `db`)
DATABASE_URL="postgresql://freerush:freerush@localhost:5432/freerush?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# --- AI engine (free tier) ---
# Google AI Studio key for Gemini 2.5 Flash. Leave blank to use the mock provider.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Free data sources ---
# Self-hosted SearXNG (docker-compose service `searxng`) used for SERP-like data.
SEARXNG_URL="http://localhost:8080"
# Self-hosted Playwright scraper service (docker-compose service `scraper`).
SCRAPER_URL="http://localhost:3001"
# PageSpeed Insights (free, 25k/day with a key). Works without a key at low volume.
PAGESPEED_API_KEY=""

# --- Google first-party data (free) — OAuth client for Search Console / Analytics / Ads ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional paid upgrades (leave blank for $0 mode) ---
FIRECRAWL_API_KEY=""
SERPAPI_API_KEY=""
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Default SERP locale for analysis
SERP_COUNTRY="au"
SERP_LANGUAGE="en"
